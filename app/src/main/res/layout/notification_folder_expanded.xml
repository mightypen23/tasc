<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Folder Tab Notch Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- Manila Folder Tab Notch -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:minWidth="90dp">

            <ImageView
                android:id="@+id/notification_tab_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/notification_folder_tab_bg" />

            <TextView
                android:id="@+id/notification_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="WORK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#132214"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>

        <!-- Shelf Spacer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notification_time_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="8dp"
            android:text="Starts in 10m"
            android:textSize="11sp"
            android:textColor="#8FA0B9"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Folder Card Body -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp">

        <ImageView
            android:id="@+id/notification_body_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/notification_folder_body_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Title"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#132214"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Category or Subtitle"
                android:textSize="13sp"
                android:textColor="#38523A"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Time Slot Badge -->
            <TextView
                android:id="@+id/notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/notification_badge_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="10:00 am - 12:00 pm"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#132214"
                android:maxLines="1" />

            <!-- Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:id="@+id/notification_btn_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/notification_btn_action_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="✓ Mark Done"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#132214" />

                <TextView
                    android:id="@+id/notification_btn_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/notification_btn_action_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Open App"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#132214" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
