<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <!-- Folder Tab Notch Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- Manila Folder Tab Notch -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:minWidth="64dp">

            <ImageView
                android:id="@+id/notification_tab_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/notification_folder_tab_bg" />

            <TextView
                android:id="@+id/notification_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="HEALTH"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#132214"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:ellipsize="end" />
        </FrameLayout>

        <!-- Recessed Shelf (Right Side) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notification_time_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="6dp"
            android:text="Starting on time • 09:26 pm"
            android:textSize="10sp"
            android:textColor="#8FA0B9"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Folder Card Body -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="38dp">

        <ImageView
            android:id="@+id/notification_body_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/notification_folder_body_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="run around"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#132214"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Health • 09:26 pm"
                android:textSize="11sp"
                android:textColor="#38523A"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
